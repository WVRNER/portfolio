<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover"
    />

    <meta name="theme-color" content="#FFC900" />

    <title>{{ title }} · wvrner</title>

    <meta
      name="description"
      content="{{ excerpt }}"
    />

    <!-- Favicon & Search Bar Icon: Bold Red Serif 'W' on Light Background (Frame 11) -->
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%2264%22%20height%3D%2264%22%20viewBox%3D%220%200%2064%2064%22%3E%3Crect%20width%3D%2264%22%20height%3D%2264%22%20rx%3D%2214%22%20fill%3D%22%23F8F8F6%22/%3E%3Ctext%20x%3D%2232%22%20y%3D%2247%22%20font-family%3D%22%27Fraunces%27%2C%20Georgia%2C%20%27Times%20New%20Roman%27%2C%20serif%22%20font-weight%3D%22900%22%20font-size%3D%2244%22%20text-anchor%3D%22middle%22%20fill%3D%22%23D60000%22%3EW%3C/text%3E%3C/svg%3E"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="data:image/png;base64,"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="data:image/png;base64,"
    />
    <link
      rel="shortcut icon"
      href="/favicon.ico?v=20261006w"
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261006w" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=20261006w" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;1,9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Stylesheets -->
    <link rel="stylesheet" href="/styles/main.css?v=20261008v5" />
    <link rel="stylesheet" href="/styles/animations.css" />
  </head>

  <body>

    {% set activeNav = "blog" %}
    {% include "header.njk" %}


    <!-- Article -->
    <main
      class="gum-section post-reading-layout"
      style="
        padding-top: 48px;
        padding-bottom: 90px;
        width: 100%;
        box-sizing: border-box;
        margin: 0 auto;
      "
    >
      <!-- Back Button -->
      <div style="max-width: 860px; margin: 0 auto 24px;">
        <a href="/blog/" class="blog-back-btn" style="margin-bottom: 0;">
          <span aria-hidden="true">&larr;</span>
          <span>Back to Engineering Notes</span>
        </a>
      </div>

      <article class="blog-article-frame" style="border: none !important; box-shadow: none !important; background: transparent !important; padding: 0 !important;">
        <!-- Article Header Section -->
        <header class="post-header-section" style="border: none !important; background: transparent !important; padding: 0 0 24px 0 !important;">
          <div class="blog-post-meta" style="margin-bottom: 16px; gap: 10px;">
            {% if featured %}
              <span class="post-featured-badge">★ FEATURED TECHNICAL WRITE-UP</span>
            {% endif %}
            <span class="blog-time-badge">
              {{ display_date }} &bull; {{ read_time }}
            </span>
          </div>

          <h1
            class="blog-post-title"
            style="
              font-size: clamp(28px, 4.2vw, 44px);
              line-height: 1.18;
              margin-bottom: 16px;
            "
          >
            {{ title }}
          </h1>

          <p
            class="blog-post-subtitle"
            style="margin: 0; padding: 0; border: none;"
          >
            {{ subtitle }}
          </p>
        </header>

        <!-- Article Body Section -->
        <div class="post-body-section blog-article-body">
          {{ content | safe }}
        </div>

        <!-- Article Footer Section -->
        <footer class="post-footer-section" style="border-top: 1.5px solid rgba(0, 0, 0, 0.15) !important; background: transparent !important; padding: 24px 0 !important;">
          <a href="/blog/" class="blog-read-more-btn">
            <span>&larr; All Articles</span>
          </a>
        </footer>
      </article>
    </main>

    {% include "footer.njk" %}


    <!-- Scripts -->
    <script src="/js/main.js?v=20261007v3"></script>
  </body>
</html>